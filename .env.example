# ==============================
# Task Manager - Environment variables
# ==============================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://taskmanager:secret@localhost:5432/taskmanager_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# --- JWT / Auth ---
SECRET_KEY=super-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI (optional). NVIDIA is used when NVIDIA_API_KEY is set; otherwise any
# OpenAI-compatible endpoint via OPENAI_BASE_URL. Ollama: OPENAI_BASE_URL=http://host:11434/v1,
# OPENAI_API_KEY=ollama (any non-empty value), and OLLAMA_CONTEXT_LENGTH=16384 or more
# on the Ollama server, or the chatbot's tool list gets cut off.
# Empty model = default: nvidia/nemotron-3.5-lightning-30b-a3b (chat and JSON jobs)
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini
AI_CHAT_MODEL=
AI_TASK_MODEL=
AI_MAX_TOKENS=4096

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Default admin (GAP-05) ---
ADMIN_EMAIL=admin@taskmanager.local
ADMIN_PASSWORD=Admin@123456

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Notification service (worker.notify) ---
NOTIFICATION_SERVICE_URL=http://localhost:8002
# Shared secret for worker.notify's HTTP API (same value in both services)
INTERNAL_API_TOKEN=
