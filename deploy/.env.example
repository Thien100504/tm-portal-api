# Copy to .env on the server and fill in every empty value.
# Generate secrets with:  openssl rand -hex 32

# Image source (GitHub Container Registry) and tag (latest, sha-xxxxxxx or v1.0.0)
REGISTRY=ghcr.io/thien100504
TAG=latest

# Public port of the web container (UI + /api + /ws)
WEB_PORT=8080

# Database
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=
POSTGRES_DB=taskmanager

# Message broker
RABBITMQ_USER=taskmanager
RABBITMQ_PASSWORD=

# Auth
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret between portal-api and worker.notify
INTERNAL_API_TOKEN=

# Start the AI worker with --profile ai
# AI (optional). NVIDIA is used when NVIDIA_API_KEY is set; otherwise any
# OpenAI-compatible endpoint via OPENAI_BASE_URL. Ollama: OPENAI_BASE_URL=http://host:11434/v1,
# OPENAI_API_KEY=ollama (any non-empty value), and OLLAMA_CONTEXT_LENGTH=16384 or more
# on the Ollama server, or the chatbot's tool list gets cut off.
# Empty model = default: z-ai/glm-5.3-flash (chat), mistralai/mistral-large-4-1t-a52b (JSON jobs)
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini
AI_CHAT_MODEL=
AI_TASK_MODEL=
AI_MAX_TOKENS=4096

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
