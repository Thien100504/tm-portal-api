# Copy to .env on the server and fill in every empty value.
# Generate secrets with:  openssl rand -hex 32

# Image source (GitHub Container Registry) and tag (latest, sha-xxxxxxx or v1.0.0)
REGISTRY=ghcr.io/thien100504
TAG=latest

# Public port of the web container (UI + /api + /ws)
WEB_PORT=8080

# Database
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=
POSTGRES_DB=taskmanager

# Message broker
RABBITMQ_USER=taskmanager
RABBITMQ_PASSWORD=

# Auth
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret between portal-api and worker.notify
INTERNAL_API_TOKEN=

# AI (optional; start the AI worker with --profile ai)
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
